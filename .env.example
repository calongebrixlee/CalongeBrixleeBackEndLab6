# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=
DB_SSL_CA=

# Initial administrator is created by the first migration when both values
# are set. Use a password with at least 12 characters.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_USERNAME=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=
FRONTEND_ORIGIN=http://localhost:5173